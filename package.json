{
	"name": "@convis/audio-native",
	"version": "0.0.2",
	"description": "Native Node (N-API) module for @convis/audio",
	"homepage": "https://github.com/k2d222/convis-audio",
	"bugs": "https://github.com/k2d222/convis-audio/issues",
	"license": "MIT",
	"author": "Mathis Brossier <mathis.brossier@gmail.com>",
	"repository": "github:k2d222/convis-audio",
	"files": [
		"./dist/index.d.ts",
		"./dist/index.js",
		"./src/*"
	],
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"node": "./dist/index.js"
	},
	"scripts": {
		"build": "pnpm run napi:build:release",
		"dev": "pnpm napi:build:debug --watch",
		"napi:build:debug": "napi build -o dist/",
		"napi:build:release": "napi build -o dist/ --release --strip",
		"download-artifacts": "sh scripts/download-artifacts.sh"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.2.0",
		"@types/node": "^25.6.2"
	},
	"optionalDependencies": {
		"@convis/audio-aarch64-apple-darwin": "workspace:*",
		"@convis/audio-aarch64-pc-windows-msvc": "workspace:*",
		"@convis/audio-aarch64-unknown-linux-gnu": "workspace:*",
		"@convis/audio-x86_64-apple-darwin": "workspace:*",
		"@convis/audio-x86_64-pc-windows-msvc": "workspace:*",
		"@convis/audio-x86_64-unknown-linux-gnu": "workspace:*"
	},
	"napi": {
		"npmClient": "pnpm",
		"binaryName": "audio",
		"targets": [
			"x86_64-unknown-linux-gnu",
			"x86_64-pc-windows-msvc",
			"x86_64-apple-darwin",
			"aarch64-unknown-linux-gnu",
			"aarch64-pc-windows-msvc",
			"aarch64-apple-darwin"
		]
	},
	"packageManager": "pnpm@10.33.3"
}
