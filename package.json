{
	"name": "@convis/audio",
	"version": "0.0.1",
	"description": "Audio module for Convisation",
	"homepage": "https://github.com/k2d222/convis",
	"bugs": "https://github.com/k2d222/convis/issues",
	"license": "MIT",
	"author": "Mathis Brossier <mathis.brossier@gmail.com>",
	"repository": "github:k2d222/convis",
	"files": [
		"./dist/*",
		"./src/*"
	],
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"node": "./dist/index.js"
	},
	"scripts": {
		"build": "rm -rf dist/ && pnpm run napi:build:release",
		"dev": "pnpm napi:build:debug --watch",
		"napi:build:debug": "napi build --platform -o dist/",
		"napi:build:release": "napi build --platform --release --strip -o dist/"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.2.0"
	},
	"optionalDependencies": {
		"@convis/audio-darwin-arm64": "workspace:*",
		"@convis/audio-linux-x64-gnu": "workspace:*",
		"@convis/audio-win32-x64-msvc": "workspace:*"
	},
	"napi": {
		"npmClient": "pnpm",
		"binaryName": "audio",
		"targets": [
			"x86_64-unknown-linux-gnu",
			"x86_64-pc-windows-msvc",
			"x86_64-apple-darwin",
			"aarch64-unknown-linux-gnu",
			"aarch64-pc-windows-msvc",
			"aarch64-apple-darwin"
		]
	}
}
